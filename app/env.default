### BrainAI server config (managed by BrainAI.app; HOST/PORT/paths are set by the app)
WEBUI_TITLE='BrainAI'
WEBUI_DESCRIPTION='Personal memory graph'
SUMMARY_LANGUAGE=Russian

### LLM — DeepSeek (OpenAI-compatible)
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.deepseek.com/v1
LLM_BINDING_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT=240
MAX_ASYNC_LLM=4
# Disable thinking for extraction speed/cost
OPENAI_LLM_EXTRA_BODY='{"thinking": {"type": "disabled"}}'

### Embeddings — Ollama bge-m3 (local, free; DeepSeek has no embeddings API)
EMBEDDING_BINDING=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=8192
OLLAMA_EMBEDDING_NUM_CTX=8192
EMBEDDING_TIMEOUT=120

### Reranking (off)
RERANK_BINDING=null

### Processing
ENABLE_LLM_CACHE=true
ENABLE_LLM_CACHE_FOR_EXTRACT=true
MAX_PARALLEL_INSERT=2
CHUNK_SIZE=800
CHUNK_OVERLAP=100

### WebUI
MAX_GRAPH_NODES=1000
