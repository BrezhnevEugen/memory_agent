### LightRAG server — DeepSeek LLM + OpenAI embeddings
HOST=0.0.0.0
PORT=9621
WEBUI_TITLE='BrainAI'
WEBUI_DESCRIPTION='Personal memory graph'
SUMMARY_LANGUAGE=Russian

### LLM — DeepSeek (OpenAI-compatible)
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.deepseek.com/v1
LLM_BINDING_API_KEY=sk-deepseek-xxx
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT=240
MAX_ASYNC_LLM=4
# Disable thinking for extraction speed/cost
OPENAI_LLM_EXTRA_BODY='{"thinking": {"type": "disabled"}}'

### Embeddings — OpenAI (DeepSeek has no embeddings API)
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://api.openai.com/v1
EMBEDDING_BINDING_API_KEY=sk-openai-xxx
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_TOKEN_LIMIT=8192

### Reranking (off)
RERANK_BINDING=null

### Processing
ENABLE_LLM_CACHE=true
ENABLE_LLM_CACHE_FOR_EXTRACT=true
MAX_PARALLEL_INSERT=2
CHUNK_SIZE=800
CHUNK_OVERLAP=100

### Storage (relative to WorkingDirectory)
WORKING_DIR=./rag_storage
INPUT_DIR=./inputs

### WebUI
MAX_GRAPH_NODES=1000
